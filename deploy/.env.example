# StackDot CRM — server environment
# Copy to `.env` next to docker-compose.yml on the server and fill in the values.
# Generate secrets with:  openssl rand -hex 32

# ── Images ────────────────────────────────────────────────
DOCKERHUB_NAMESPACE=jeeejagani
# Pin to a commit tag (e.g. sha-1a2b3c4) to roll back
API_TAG=latest
WEB_TAG=latest

# ── Public URL / port ─────────────────────────────────────
WEB_PORT=80
# Exact URL users open in the browser (scheme + host + port; used as the API's CORS origin)
CLIENT_URL=http://YOUR_SERVER_IP
# true only when CLIENT_URL is https:// — browsers drop Secure cookies over plain http
COOKIE_SECURE=false

# ── Database (bundled postgres container) ─────────────────
POSTGRES_USER=crm
POSTGRES_DB=crm
# Use letters/digits only (it is embedded in a connection URL)
POSTGRES_PASSWORD=CHANGE_ME

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Encrypts SMTP passwords saved in System Settings. Set once; changing it later
# makes previously saved SMTP passwords unreadable.
ENCRYPTION_KEY=CHANGE_ME

# ── Email (optional) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="StackDot CRM <no-reply@example.com>"
